# ommega A 端 SELinux 规则。
#
# 注入目标：keystore2、SOTER 宿主（system_app / platform_app / priv_app）、SOTER HAL。
# 注入器用 unix dgram 把 payload 的 fd 递进目标进程，目标进程连 daemon 的抽象 socket
# 取答复并落日志。
#
# 域名随 ROM 变，kernel 跳过策略里不存在的域名。一行一个域：列表写法会被解析器丢弃。

# 注入与兜底落地的域整域放宽。
permissive keystore
permissive system_app
permissive platform_app
permissive priv_app
permissive hal_soter
permissive hal_soter_default
permissive hal_soter_qti
permissive vendor_hal_soter_qti
permissive hal_soter_trustonic
permissive hal_soter_service
permissive vendor_hal_soteraidl_service
permissive hal_cryptoeng_oplus

# 递 payload 的 dgram：发送方是注入器（域随根实现变）。
allow { system_file ksu magisk su } keystore unix_dgram_socket sendto
allow { system_file ksu magisk su } { system_app platform_app priv_app } unix_dgram_socket sendto
allow { system_file ksu magisk su } { hal_soter hal_soter_default hal_soter_qti } unix_dgram_socket sendto
allow { system_file ksu magisk su } { vendor_hal_soter_qti hal_soter_trustonic hal_soter_service } unix_dgram_socket sendto
allow { system_file ksu magisk su } { hal_cryptoeng_oplus } unix_dgram_socket sendto

# 软件 SOTER TA 注册服务名（运行域是 shell 或 root）。
allow { magisk ksu su system_file } default_android_service service_manager { add find }
allow shell vendor_hal_soteraidl_service service_manager { add find }
allow shell vendor_hal_soter_hwservice hwservice_manager { add find }
# 注册时 servicemanager 读调用方的 SELinux 上下文。
allow servicemanager shell file { read open getattr }
allow servicemanager shell dir { search getattr }

# keystore2 崩溃时 crash_dump 读它的进程。
allow crash_dump keystore process *

# payload 跑在 keystore 域里，要读写 /data/misc/keystore/ommega 下的配置、心跳、日志。
# 这一块以前完全靠上面的 permissive 兜着，每笔访都在内核里记一条 denied 审计；
# 写清楚之后审计不再刷，将来真收紧也不会炸。
#
# keymaster.db 在数据根里，SQLite 会自己开 journal、加锁、删 journal，少了 lock/unlink/rename
# 就是每写一笔刷三条 denied（实测）。injector.log 的轮转要 append/setattr。
allow keystore system_data_file file { read open getattr write create lock unlink rename setattr }
allow keystore system_data_file dir { read open search getattr write add_name remove_name }
allow keystore system_app_data_file dir { read open search getattr lock write add_name }
allow keystore system_app_data_file file { read open getattr write create append setattr }
# 远程出证的连接：reqwest 要建 socket、连、读写、收尾（之前只放了 shutdown，其余全靠
# permissive 兜，每笔连接都在内核里刷几条 denied）。链路上会去读网卡状态、查权限服务，
# 一并写清。
#
# 这里写 `keystore keystore` 而不是 `keystore self`：KernelSU 的 ksud 解析器不认
# `self`（当成普通类型名发给内核，内核查不到就 -EINVAL），我们的 ommega-policy
# 两种都支持。写开之后两条路都能应用。
allow keystore keystore tcp_socket { create connect read write getattr shutdown }
allow keystore sysfs_net { dir { read open getattr search } file { read open getattr } }
allow keystore permissionmgr_service service_manager find

# 工程模式建 ID attestation 钥匙时检查调用方的 gen_unique_id。
allow engineermode_app keystore keystore2_key { gen_unique_id }
