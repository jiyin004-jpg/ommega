#!/system/bin/sh

MODDIR=${0%/*}
STATE_DIR=/data/adb/ommega
BIN_DIR=$STATE_DIR/bin
CONF_DIR=$STATE_DIR/conf
RUN_DIR=$STATE_DIR/run
DB_DIR=$STATE_DIR/db
[ -f "$MODDIR/layout.sh" ] && . "$MODDIR/layout.sh" 2>/dev/null
RESTART_FILE=$RUN_DIR/restart.keymint
PEER_RESTART_FILE=$RUN_DIR/restart.injector
RESTART_ALL_FILE=$RUN_DIR/restart.all
CONF_PATH=${OMMEGA_CONF_PATH:-/data/misc/keystore/ommega/config}
LOG_DIR=/data/misc/keystore/ommega/logs
LOG_FILE=$LOG_DIR/daemon.log

# 本脚本的日志只落文件（见下面 log 的定义），「启用调试日志」关着时一条都不打。
# 开关按 2 秒一次的循环现读。
conf_get() {
  [ -f "$CONF_PATH" ] || return 0
  sed -n "s/^[[:space:]]*$1[[:space:]]*:[[:space:]]*\(.*\)$/\1/p" "$CONF_PATH" 2>/dev/null | head -n1
}

debug_logging_enabled() {
  case "$(conf_get debug_logging | tr 'A-Z' 'a-z' | tr -d ' \r')" in
    1|true|yes|on) return 0 ;;
  esac
  return 1
}

# 日志只落文件：以前这里是 echo，输出会进管理器的 service 日志（那也是系统日志），
# 现在跟 daemon / payload 统一写到一个文件里。「启用调试日志」关着时一条都不打，
# 开关按 2 秒一次的循环现读。
log() {
  [ "$LOG_ON" = "1" ] || return 0
  mkdir -p "$LOG_DIR" 2>/dev/null
  printf '%s [INFO] %s\n' "$(date -u '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE" 2>/dev/null
  return 0
}

# Extra library search paths are only needed on older Android. From Android 16
# (SDK 36) the default linker namespace already covers vendor/system/apex
# bionic, and overriding LD_LIBRARY_PATH here makes the linker resolve a
# libc++.so without `hash_memory`, so even sleep/chmod fail with
# "CANNOT LINK ... cannot locate symbol _ZNSt3__113hash_memoryEPKVm".
# keymint links fine with the defaults, so skip the override on SDK >= 36.
_SDK=$(getprop ro.build.version.sdk 2>/dev/null)
if [ -z "$_SDK" ] || [ "$_SDK" -lt 36 ]; then
  export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/vendor/lib64/:/system/lib64/:/apex/com.android.runtime/lib64/bionic/"
fi
unset _SDK

# Resolve the device ABI.  One module zip now carries every ABI at once, so
# libs/<abi> has to be picked by what this device actually runs; falling back
# to directory order would hand an x86_64 device the arm64 binary.
device_abi() {
  local abi
  abi="$(getprop ro.product.cpu.abi 2>/dev/null)"
  [ -n "$abi" ] || abi="$(uname -m 2>/dev/null)"
  case "$abi" in
    arm64*|aarch64*) echo arm64-v8a ;;
    armeabi*|armv7*) echo armeabi-v7a ;;
    x86_64*) echo x86_64 ;;
    i?86|x86) echo x86 ;;
    *) echo "" ;;
  esac
}

find_module_keymint() {
  if [ -f "$BIN_DIR/keymint" ]; then
    echo "$BIN_DIR/keymint"
    return 0
  fi
  if [ -f "$MODDIR/keymint" ]; then
    echo "$MODDIR/keymint"
    return 0
  fi

  local abi
  abi=$(device_abi)
  if [ -n "$abi" ] && [ -f "$MODDIR/libs/$abi/keymint" ]; then
    echo "$MODDIR/libs/$abi/keymint"
    return 0
  fi

  # getprop/uname unavailable; accept any packaged ABI rather than nothing.
  for abi in arm64-v8a armeabi-v7a x86_64 x86; do
    if [ -f "$MODDIR/libs/$abi/keymint" ]; then
      echo "$MODDIR/libs/$abi/keymint"
      return 0
    fi
  done
  return 1
}

expand_shared_restart() {
  if [ -f "$RESTART_ALL_FILE" ]; then
    : > "$RESTART_FILE"
    : > "$PEER_RESTART_FILE"
    rm -f "$RESTART_ALL_FILE"
  fi
}

consume_restart_request() {
  expand_shared_restart

  if [ -f "$RESTART_FILE" ]; then
    rm -f "$RESTART_FILE"
    return 0
  fi

  return 1
}

cd "$MODDIR" || exit 1
mkdir -p "$STATE_DIR"

# 单实例：同一个守护脚本只允许一份活。service.sh 那层看门循环有可能同时存在多份
# （管理器把 service.sh 拉起多次、或旧循环没清干净），每份都会 fork 一个本脚本，
# 而本脚本每轮开头都会 `pkill -9 -f <keymint 路径>` —— 多份并存时彼此把对方的
# shadow 反复 SIGKILL（daemon.log 里一串 exited with code 137）。抢不到锁的直接退。
LOCK_DIR=$RUN_DIR/keymint-daemon.lock

# 锁里的 pid 可能是上一个实例留下的，而那个 pid 号早被别的进程复用了 —— 只看 kill -0
# 会一直以为「还有人在跑」，守护就永久起不来（2026-10-16 在 NX721J / OPD2409 上都踩到：
# 锁里留着 1666，重启后那个号被内核线程占了，keymint 静默 exit 0，看门循环空转）。
# 所以除了「还活着」，还要确认这个 pid 现在跑的确实是本脚本。
holder_is_us() {
  p=$1
  s=$2
  [ -n "$p" ] || return 1
  kill -0 "$p" 2>/dev/null || return 1
  [ -r "/proc/$p/cmdline" ] || return 1
  # cmdline 里的 NUL 转成空格，所以脚本路径后面一定跟着空格，正好把 daemon 和
  # daemon-injector 这种前缀相同的名字区分开。
  tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -F "sh $s " >/dev/null 2>&1
}

# 只认自己持有的锁：抢锁有竞态（两个实例同时认定「这是陈锁」时，先清后建的那份会把
# 对方刚建的锁删掉，结果两份都在跑、互相 pkill），所以拿到之后要再核一次归属，
# 退出时也只删自己的，别把下一任持有者的锁带走。
lock_owned() { [ "$(cat "$LOCK_DIR/pid" 2>/dev/null)" = "$$" ]; }
release_lock() { lock_owned && rm -rf "$LOCK_DIR" 2>/dev/null; return 0; }

acquire_singleton() {
  mkdir -p "$STATE_DIR" 2>/dev/null
  if mkdir "$LOCK_DIR" 2>/dev/null; then
    :
  else
    holder=$(cat "$LOCK_DIR/pid" 2>/dev/null)
    if holder_is_us "$holder" "$0"; then
      log "[keymint-daemon] another instance (pid $holder) is running; exiting"
      exit 0
    fi
    rm -rf "$LOCK_DIR" 2>/dev/null
    mkdir "$LOCK_DIR" 2>/dev/null || exit 0
  fi
  echo $$ > "$LOCK_DIR/pid"
  # 抢锁竞态兜底：再核一次，确实归自己才往下跑。
  sleep 1
  lock_owned || exit 0
  trap 'release_lock' EXIT INT TERM HUP
}
acquire_singleton

LOG_ON=0

# 把 B 真机链里声明的设备身份对齐到本机：链是真机出的，本机属性就必须说同一台
# 机器，否则检测器比两边会报 device_properties / VBMeta 摘要不一致。
#
# TA 每次出链都会写这个文件，但只有部分请求要了 ID 证明（带 brand/model），
# 所以文件是“时全时缺”的。这里做**合并**：`remote_identity.applied` 就是当前已知
# 身份，只把非空字段并进去；只有真的出现新值才重启 zygote（否则会反复重启）。
REMOTE_IDENTITY_FILE=/data/misc/keystore/ommega/remote_identity
REMOTE_IDENTITY_APPLIED=$CONF_DIR/remote_identity.applied

resetprop_set() {
  [ -n "$1" ] && [ -n "$2" ] || return 0
  if [ -x "$BIN_DIR/resetprop" ]; then
    "$BIN_DIR/resetprop" "$1" "$2" >/dev/null 2>&1
  else
    resetprop "$1" "$2" >/dev/null 2>&1
  fi
}

# key -> 要改的属性名
id_prop_name() {
  case "$1" in
    brand) echo ro.product.brand ;;
    device) echo ro.product.device ;;
    product) echo ro.product.name ;;
    manufacturer) echo ro.product.manufacturer ;;
    model) echo ro.product.model ;;
    serial) echo ro.serialno ;;
    vbmeta_digest) echo ro.boot.vbmeta.digest ;;
    *) echo "" ;;
  esac
}

sync_remote_identity() {
  [ -f "$REMOTE_IDENTITY_FILE" ] || return 0
  # 面板「伪装参数」里手动写过身份就以面板为准（props.conf 里有 ro.product.model 就不动）。
  if [ -f "$CONF_DIR/props.conf" ] && grep -q '^[[:space:]]*ro\.product\.model[[:space:]]*:' "$CONF_DIR/props.conf" 2>/dev/null; then
    return 0
  fi
  changed=0
  model_changed=0
  brand_changed=0
  device_changed=0
  for key in brand device product manufacturer model serial vbmeta_digest; do
    new=$(sed -n "s/^$key=//p" "$REMOTE_IDENTITY_FILE" 2>/dev/null | head -n1)
    [ -n "$new" ] || continue
    old=$(sed -n "s/^$key=//p" "$REMOTE_IDENTITY_APPLIED" 2>/dev/null | head -n1)
    [ "$new" = "$old" ] && continue
    prop=$(id_prop_name "$key")
    [ -n "$prop" ] || continue
    resetprop_set "$prop" "$new"
    # 合并进已应用记录
    grep -v "^$key=" "$REMOTE_IDENTITY_APPLIED" > "$REMOTE_IDENTITY_APPLIED.tmp" 2>/dev/null
    printf '%s=%s\n' "$key" "$new" >> "$REMOTE_IDENTITY_APPLIED.tmp"
    mv "$REMOTE_IDENTITY_APPLIED.tmp" "$REMOTE_IDENTITY_APPLIED" 2>/dev/null
    changed=1
    case "$key" in
      model) model_changed=1 ;;
      brand) brand_changed=1 ;;
      device) device_changed=1 ;;
    esac
  done
  # boot 锁定 / 验证状态 —— 这两项不是 1:1 映射到属性名（值要转文案），单独处理。
  ri_locked=$(sed -n 's/^device_locked=//p' "$REMOTE_IDENTITY_FILE" 2>/dev/null | head -n1)
  case "$ri_locked" in
    0)
      resetprop_set ro.boot.vbmeta.device_state unlocked
      resetprop_set ro.boot.flash.locked 0
      ;;
    1)
      resetprop_set ro.boot.vbmeta.device_state locked
      resetprop_set ro.boot.flash.locked 1
      ;;
  esac
  ri_state=$(sed -n 's/^verified_boot_state=//p' "$REMOTE_IDENTITY_FILE" 2>/dev/null | head -n1)
  case "$ri_state" in
    0) resetprop_set ro.boot.verifiedbootstate green ;;
    1) resetprop_set ro.boot.verifiedbootstate yellow ;;
    2) resetprop_set ro.boot.verifiedbootstate orange ;;
    3) resetprop_set ro.boot.verifiedbootstate red ;;
  esac
  # 719：证书里是 YYYYMMDD，属性是 YYYY-MM-DD
  ri_patch=$(sed -n 's/^boot_patchlevel=//p' "$REMOTE_IDENTITY_FILE" 2>/dev/null | head -n1)
  case "$ri_patch" in
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
      resetprop_set ro.boot.build.security_patch \
        "$(printf '%s' "$ri_patch" | sed 's/^\([0-9]\{4\}\)\([0-9]\{2\}\)\([0-9]\{2\}\)$/\1-\2-\3/')"
      ;;
  esac
  if [ "$changed" = "1" ]; then
    [ "$model_changed" = "1" ] && resetprop_set ro.product.model "$(sed -n 's/^model=//p' "$REMOTE_IDENTITY_APPLIED" | head -n1)"
    [ "$brand_changed" = "1" ] && resetprop_set ro.product.brand "$(sed -n 's/^brand=//p' "$REMOTE_IDENTITY_APPLIED" | head -n1)"
    [ "$device_changed" = "1" ] && resetprop_set ro.product.device "$(sed -n 's/^device=//p' "$REMOTE_IDENTITY_APPLIED" | head -n1)"
    # 分区级属性只在已经存在时才改（不少 ROM 会优先读它们）。
    model=$(sed -n 's/^model=//p' "$REMOTE_IDENTITY_APPLIED" | head -n1)
    brand=$(sed -n 's/^brand=//p' "$REMOTE_IDENTITY_APPLIED" | head -n1)
    device=$(sed -n 's/^device=//p' "$REMOTE_IDENTITY_APPLIED" | head -n1)
    for part in system vendor odm product system_ext; do
      [ -n "$(getprop "ro.product.$part.model" 2>/dev/null)" ] && resetprop_set "ro.product.$part.model" "$model"
      [ -n "$(getprop "ro.product.$part.brand" 2>/dev/null)" ] && resetprop_set "ro.product.$part.brand" "$brand"
      [ -n "$(getprop "ro.product.$part.device" 2>/dev/null)" ] && resetprop_set "ro.product.$part.device" "$device"
    done
    log "[keymint-daemon] remote identity applied: $brand/$model"
    # 只写属性，**绝不自动重启 zygote**：
    # 身份文件是 TA 每次出链都会写的（有时带 brand/model、有时只带 digest），
    # 以前在这里自动 `setprop ctl.restart zygote`，就变成「重启 → 应用重启 → 又认证
    # → 又写文件 → 又重启」的死循环，最后把系统保护触到 recovery。
    # 现在只落一个标记文件，重启由人手动决定（或面板按钮）。
    printf '%s\n' "$brand/$model" > "$CONF_DIR/remote_identity.updated" 2>/dev/null
  fi
}

while true; do
  LOG_ON=0
  debug_logging_enabled && LOG_ON=1

  TARGET=$(find_module_keymint)
  if [ -z "$TARGET" ]; then
    log "[keymint-daemon] keymint binary not found"
    sleep 5
    continue
  fi

  chmod 0755 "$TARGET"

  # Clear a stale keymint instance (exact binary path) before starting a
  # fresh one, so a leftover child from a previous daemon run can never
  # coexist with the new instance. No other module process is matched.
  pkill -9 -f "$TARGET" 2>/dev/null
  sleep 1

  "$TARGET" "$@" &
  child_pid=$!

  while kill -0 "$child_pid" 2>/dev/null; do
    if consume_restart_request; then
      log "[keymint-daemon] restart requested"
      kill -TERM "$child_pid" 2>/dev/null
      sleep 2
      if kill -0 "$child_pid" 2>/dev/null; then
        kill -KILL "$child_pid" 2>/dev/null
      fi
      break
    fi
    sync_remote_identity
    sleep 2
  done

  wait "$child_pid"
  rc=$?
  log "[keymint-daemon] keymint exited with code $rc"
  sleep 2
done
