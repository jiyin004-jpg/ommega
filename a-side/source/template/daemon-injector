#!/system/bin/sh

MODDIR=${0%/*}
STATE_DIR=/data/adb/ommega
PAYLOAD_STATE_FILE=$STATE_DIR/injector.payload
RESTART_FILE=$STATE_DIR/restart.injector
PEER_RESTART_FILE=$STATE_DIR/restart.keymint
RESTART_ALL_FILE=$STATE_DIR/restart.all

# A 端平铺 config（WebUI 写的），只有 soter_inject 这个键是本脚本读的：
# 关着（键不在、或写了 0/false）就完全不碰 SOTER 宿主——不起服务、不注入；
# 开着才 `am start-service` 把它拉起来再注进去。
CONF_PATH=${OMMEGA_CONF_PATH:-/data/misc/keystore/ommega/config}
# 日志开关的副本：payload 有可能落进读不到上面那个配置的域（SOTER 宿主是 uid 1000），
# 它按这个文件决定写不写日志。内容只有 `log_flag: 0|1` 一行，别往里放别的。
# 放 /data/misc 下面是因为宿主（system_app）连 /data/adb（0700 root）都进不去，
# 而这里的 context 是 system_data_file，它读得到。
LOG_FLAG=${OMMEGA_LOG_FLAG_PATH:-/data/misc/ommega/log_flag}
# root 侧写给 daemon 的「uid → 包名」表（它就从系统自己的 packages.list 抄）。
# 放 keystore 那个目录里是因为 daemon 就跑在 keystore uid，那个目录它读得到。
UID_PACKAGES_OUT=/data/misc/keystore/ommega/uid_packages
PACKAGES_LIST=/data/system/packages.list
# daemon 拿去做最后一道兜底的「当前前台应用」（它跑在 keystore uid，只读得到这个目录）。
FOREGROUND_OUT=/data/misc/keystore/ommega/foreground
# 载荷（跑在 SOTER 宿主，system_app 域）读不到 keystore 那个 0770 目录，得给它一份
# 读得到的配置副本 —— 那台小米就是这么在宿主里自我禁用的（injector.toml Permission denied）。
INJECTOR_TOML=/data/misc/keystore/ommega/injector.toml
INJECTOR_TOML_COPY=/data/misc/ommega/injector.toml
# 载荷（宿主域）自己翻包名要用的两份副本：表 `uid package` 和前台应用。
# 原理同 injector.toml —— keystore 那个 0770 目录宿主进不去，得给一份读得到的。
UID_PACKAGES_COPY=/data/misc/ommega/uid_packages
FOREGROUND_COPY=/data/misc/ommega/foreground
LOG_FLAG_DIR=$(dirname "$LOG_FLAG")
# 本脚本自己的日志，只落文件（以前是 echo，会进管理器的 service 日志）。
LOG_DIR=/data/misc/keystore/ommega/logs
LOG_FILE=$LOG_DIR/daemon-injector.log
# app 域里那份 payload（SOTER 宿主 uid 1000）写不进上面那个 keystore 目录，
# 得给它一个自己写得动的位置，权限开到 system 组。
APP_LOG_DIR=$LOG_FLAG_DIR/logs
# 换本地兜底 ASK 的通道：往真配置目录里放一份 soter_ask.pem（PKCS#8 PEM），
# 这里抄到 app 域读得到的位置，再把 SOTER 宿主踢一次让新 key 生效。
SOTER_ASK_DST=/data/misc/ommega/soter_ask.pem
# daemon 学到的真机 cpu_id：它自己那份写在 keystore 域（它跑在 keystore uid 里，别处
# 写不动），这里抄到 app 域给宿主里那份 payload 读。内容就一行 `soter_cpu_id: <32 hex>`。
SOTER_CPU_ID_DST=/data/misc/ommega/soter_cpu_id
SOTER_PKG=com.tencent.soter.soterserver
SOTER_ACTION=$SOTER_PKG.ISoterService
# daemon 判出「SOTER 宿主哑了」时写的标记。它跑在 keystore uid，只写得动自己那个目录
# （`src/soter_host_health.rs`）；写一行原因，这里读走、删掉，再把宿主换成新实例。
SOTER_STUCK_FILE=/data/misc/keystore/ommega/soter_host_stuck

# Resolve the device ABI.  One module zip now carries every ABI at once, so
# libs/<abi> has to be picked by what this device actually runs; falling back
# to directory order would hand an x86_64 device the arm64 binary.
device_abi() {
  local abi
  abi="$(getprop ro.product.cpu.abi 2>/dev/null)"
  [ -n "$abi" ] || abi="$(uname -m 2>/dev/null)"
  case "$abi" in
    arm64*|aarch64*) echo arm64-v8a ;;
    armeabi*|armv7*) echo armeabi-v7a ;;
    x86_64*) echo x86_64 ;;
    i?86|x86) echo x86 ;;
    *) echo "" ;;
  esac
}

find_module_injector() {
  if [ -f "$STATE_DIR/ommega-inject" ]; then
    echo "$STATE_DIR/ommega-inject"
    return 0
  fi
  if [ -f "$MODDIR/ommega-inject" ]; then
    echo "$MODDIR/ommega-inject"
    return 0
  fi

  local abi
  abi=$(device_abi)
  if [ -n "$abi" ] && [ -f "$MODDIR/libs/$abi/ommega-inject" ]; then
    echo "$MODDIR/libs/$abi/ommega-inject"
    return 0
  fi

  # getprop/uname unavailable; accept any packaged ABI rather than nothing.
  for abi in arm64-v8a armeabi-v7a x86_64 x86; do
    if [ -f "$MODDIR/libs/$abi/ommega-inject" ]; then
      echo "$MODDIR/libs/$abi/ommega-inject"
      return 0
    fi
  done
  return 1
}

prepare_injector() {
  TARGET_INJECTOR=$(find_module_injector)
  if [ -z "$TARGET_INJECTOR" ]; then
    log "[injector-daemon] injector binary not found"
    return 1
  fi

  chmod 0755 "$TARGET_INJECTOR" 2>/dev/null || true
  chcon u:object_r:system_file:s0 "$TARGET_INJECTOR" 2>/dev/null || true
  if [ ! -x "$TARGET_INJECTOR" ]; then
    log "[injector-daemon] injector binary missing or not executable: $TARGET_INJECTOR"
    return 1
  fi
  return 0
}

expand_shared_restart() {
  if [ -f "$RESTART_ALL_FILE" ]; then
    : > "$RESTART_FILE"
    : > "$PEER_RESTART_FILE"
    rm -f "$RESTART_ALL_FILE"
  fi
}

consume_restart_request() {
  expand_shared_restart

  if [ -f "$RESTART_FILE" ]; then
    rm -f "$RESTART_FILE"
    return 0
  fi

  return 1
}

get_keystore_pid() {
  pidof keystore2 2>/dev/null | awk '{print $1}'
}

conf_get() {
  [ -f "$CONF_PATH" ] || return 0
  sed -n "s/^[[:space:]]*$1[[:space:]]*:[[:space:]]*\(.*\)$/\1/p" "$CONF_PATH" 2>/dev/null | head -n1
}

# 0 = WebUI 「注入 SOTER 服务」开着。键不在（全新安装的默认）就是关，所以只有显式
# 写了真值才认；WebUI 写的是 1/0，手写的 true/on 也认。
soter_inject_enabled() {
  case "$(conf_get soter_inject | tr 'A-Z' 'a-z' | tr -d ' \r')" in
    1|true|yes|on) return 0 ;;
  esac
  return 1
}

# 日志只落文件。「启用调试日志」关着时一条都不打，开关按循环现读，WebUI 一改
# 下一次循环就跟着变。
log() {
  [ "$LOG_ON" = "1" ] || return 0
  mkdir -p "$LOG_DIR" 2>/dev/null
  printf '%s [INFO] %s\n' "$(date -u '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE" 2>/dev/null
  return 0
}

# 0 = 「启用调试日志」开着。键不在或写了假值都算关。
debug_logging_enabled() {
  case "$(conf_get debug_logging | tr 'A-Z' 'a-z' | tr -d ' \r')" in
    1|true|yes|on) return 0 ;;
  esac
  return 1
}

# 把开关落成一行给 payload 看（内容没变就不动文件，别每 5 秒写一次）。
sync_log_flag() {
  want=0
  debug_logging_enabled && want=1
  # app 域那几个（SOTER 宿主里那份 payload）要用这个目录；顺手建掉，内容没变
  # 的时候也不多做别的事。
  mkdir -p "$APP_LOG_DIR" 2>/dev/null
  chown 0:1000 "$APP_LOG_DIR" 2>/dev/null
  # 0777 是给 SOTER 宿主留的：红魔上它是 system(1000)（组权限就够），一加 PLC110
  # 上它是 u0_a292(10292) —— 既不是属主也不在 system 组，只有 other 那一档能救。
  # 代价是这个目录谁都能写，但里面只有我们自己的调试日志，放它去。
  chmod 0777 "$APP_LOG_DIR" 2>/dev/null
  # 标签得是 system_app_data_file。默认继承下来的 system_data_file 下面，
  # system_app（SOTER 宿主 uid 1000）连自己属主的日志文件都开不了写，那份日志
  # 会整条哑掉；换成 system_app_data_file 才写得动。启动时的 restorecon 会把
  # 它改回去，所以每轮都补一次。已经打开的 fd 不受重新打标影响。
  chcon u:object_r:system_app_data_file:s0 "$APP_LOG_DIR" 2>/dev/null
  for f in "$APP_LOG_DIR"/*; do
    [ -f "$f" ] && chcon u:object_r:system_app_data_file:s0 "$f" 2>/dev/null
  done
  # 那份日志是先到的那个进程建的（HAL 是 system(1000)，宿主是一加上的 u0_a292(10292)），
  # 属主只有一个，另一个只能靠 other 那一档写。这里统一放到 0666，谁续写都行；
  # 里面只有我们自己的调试日志，不怕被读。文件不在就先放一个空的。
  APP_LOG_FILE=$APP_LOG_DIR/injector.log
  [ -f "$APP_LOG_FILE" ] || : > "$APP_LOG_FILE" 2>/dev/null
  chmod 0666 "$APP_LOG_FILE" 2>/dev/null
  chcon u:object_r:system_app_data_file:s0 "$APP_LOG_FILE" 2>/dev/null
  mkdir -p "$LOG_FLAG_DIR" 2>/dev/null
  # 这个目录里可能放着用户自己替换的 soter_ask.pem（本地兜底的私钥），
  # 所以不能让 other 进得来读：属主给 system(1000) 是因为 app 域的 payload
  # 要进来读开关和钥匙。
  chown 0:1000 "$LOG_FLAG_DIR" 2>/dev/null
  # 0711：other 只给穿越权，不给列目录权 —— 上面那个 soter_ask.pem（本地兜底
  # 私钥，0640）还在别的权限保护着，列不出来也读不到；但宿主得能穿过这一层去
  # 写 logs/，所以 x 必须给。每轮都补：boot 时的 restorecon 不碰权限，但用户
  # 手动改过或者从别的版本升上来就不一定了。
  chmod 0711 "$LOG_FLAG_DIR" 2>/dev/null
  cur=$(sed -n 's/^log_flag:[[:space:]]*//p' "$LOG_FLAG" 2>/dev/null | head -n1 | tr -d ' \r')
  if [ "$cur" != "$want" ]; then
    printf 'log_flag: %s\n' "$want" > "$LOG_FLAG" 2>/dev/null
    # 0644 而不是 0640：一加 PLC110 上宿主是 u0_a292(10292)，不在 system 组里，
    # 0640 它读不到 —— 开关读不到就等于关着，它那份日志永远不会写出来。
    # 内容就一行 log_flag，不算秘密。
    chmod 0644 "$LOG_FLAG" 2>/dev/null
  fi
}

soter_pid() {
  pidof "$SOTER_PKG" 2>/dev/null | awk '{print $1}'
}

# 配置目录里的 soter_ask.pem 变过就抄一份到 app 域能读的位置（宿主进不去 keystore
# 目录）。抄完置 soter_ask_changed=1，主循环把宿主踢掉重来。
sync_soter_ask() {
  soter_ask_changed=0
  src=$(dirname "$CONF_PATH")/soter_ask.pem

  # 源没了就把镜像那份也删掉，回到 payload 里编进去的那把。只做单向镜像不改的话，
  # 换过一次钥匙之后，就算把文件删了也还是那把旧的（镜像还在）。
  if [ ! -f "$src" ]; then
    if [ -f "$SOTER_ASK_DST" ]; then
      if rm -f "$SOTER_ASK_DST" 2>/dev/null; then
        soter_ask_changed=1
        log "[injector-daemon] local soter ask removed; back to the built-in key"
      fi
    fi
    return 0
  fi

  if [ -f "$SOTER_ASK_DST" ] \
    && [ "$(cat "$src" 2>/dev/null)" = "$(cat "$SOTER_ASK_DST" 2>/dev/null)" ]; then
    return 0
  fi

  if cp -f "$src" "$SOTER_ASK_DST" 2>/dev/null; then
    # 640 而不是 644：这是私钥。app 域的 payload 是 uid 1000，靠 system
    # 组权限读得到，其他 app 就不行了。
    chown 0:1000 "$SOTER_ASK_DST" 2>/dev/null
    chmod 0640 "$SOTER_ASK_DST" 2>/dev/null
    soter_ask_changed=1
    log "[injector-daemon] local soter ask updated from $src"
  else
    log "[injector-daemon] failed to copy $src to $SOTER_ASK_DST"
  fi
}

# 真机 cpu_id 镜像到 app 域。不删旧件：源不在只说明「daemon 还没学到」（B 端不在线、
# 或者刚装完还没跑完第一轮），把上一回学到的号删掉只会让本地兜底退回去用派生的假号 ——
# 那正是检测器报「两次 cpuid 不一致」的根。
#
# 不需要踢 SOTER 宿主：payload 每 30 秒看一眼这个文件，换了号下一次调用就跟上。
sync_soter_cpu_id() {
  src=$(dirname "$CONF_PATH")/soter_cpu_id
  [ -f "$src" ] || return 0

  if [ -f "$SOTER_CPU_ID_DST" ] \
    && [ "$(cat "$src" 2>/dev/null)" = "$(cat "$SOTER_CPU_ID_DST" 2>/dev/null)" ]; then
    return 0
  fi

  if cp -f "$src" "$SOTER_CPU_ID_DST" 2>/dev/null; then
    # 644：这个号不是秘密（App 走 SOTER 本来就看得到），而宿主在红魔上是 uid 1000、
    # 一加上是 u0_a292(10292) —— 属主给 0、组给不到它头上，只有 other 那一档人人读得到。
    chown 0:0 "$SOTER_CPU_ID_DST" 2>/dev/null
    chmod 0644 "$SOTER_CPU_ID_DST" 2>/dev/null
    log "[injector-daemon] device cpu_id mirrored from $src"
  else
    log "[injector-daemon] failed to mirror $src to $SOTER_CPU_ID_DST"
  fi
}

# 换 key 之后把 SOTER 宿主停掉：key 是进程启动时加载的，它下一次被 bind 起来
# 的时候会重新加载。
#
# 自愈也用这个：宿主「哑了」（收得到 App 侧调用、却一笔都不往 HAL 发）只有换实例才救得回来。
# 第二个参数是日志里那句理由：不说清的话，两种场景在日志里长得一样。
restart_soter_host() {
  # pid 必须是局部的：它跟主循环那个 keystore2 的 pid 同名，不声明 local 就会把循环里的
  # 目标冲成 SOTER 宿主的 pid（日志打错 pid，重试冷却也失效）。
  local pid reason
  reason=${1:-"so the new soter ask takes effect"}
  pid=$(soter_pid)
  [ -n "$pid" ] || return 0
  log "[injector-daemon] stopping $SOTER_PKG pid=$pid $reason"
  kill -TERM "$pid" 2>/dev/null
  sleep 2
  kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
  return 0
}

# SOTER 宿主是 bind-only 的服务：没人要就不起来，所以开关开着时得替客户端先喊一声。
# 拉不起来只记一行、不死循环重试（启动失败通常是系统那边的问题，本模块管不了）。
start_soter_service() {
  log "[injector-daemon] soter_inject on; starting $SOTER_PKG"
  am start-service -a "$SOTER_ACTION" >/dev/null 2>&1
  i=0
  while [ -z "$(soter_pid)" ] && [ "$i" -lt 20 ]; do
    sleep 0.5
    i=$((i + 1))
  done
  [ -n "$(soter_pid)" ] || log "[injector-daemon] $SOTER_PKG did not come up"
}

is_injected() {
  # 同上：调用方会用 keystore2 的 pid / SOTER 的 pid 各叫一次，局部化才不会互相覆盖。
  local pid maps
  pid=$1
  maps=/proc/$pid/maps
  [ -r "$maps" ] || return 1

  if [ -r "$PAYLOAD_STATE_FILE" ]; then
    # 状态文件里是 `<pid> <memfd 名字>`（载荷走 memfd，名字是每轮随机生成的
    # `lib<32hex>.so`，磁盘上算不出来，只能从这儿拿）。同一个 pid 可能留了好几行，
    # 取最后一条。
    #
    # 这里**不能**写 `toybox awk`：这台机器（nubia NX721J）的 toybox 没有 awk 这个
    # applet，整段判据静默失败，于是每轮都判「没注上」、每 16 秒重新 ptrace 注一遍
    # ——实测这个循环会让 MT 管理器刷根目录卡住十来秒、只显示普通权限那份列表。
    # 用纯 shell，不依赖 awk。
    local ident line_pid line_ident
    ident=""
    while read -r line_pid line_ident _rest; do
      [ "$line_pid" = "$pid" ] || continue
      [ -n "$line_ident" ] && ident=$line_ident
    done < "$PAYLOAD_STATE_FILE"

    if [ -n "$ident" ] && grep -qF "$ident" "$maps" 2>/dev/null; then
      return 0
    fi
  fi

  grep -F "$TARGET_INJECTOR" "$maps" >/dev/null 2>&1 && return 0
  return 1
}

# root 侧把「uid → 包名」抄一份给 daemon。
#
# 为什么要它：AAID 服务在分身/空间/多用户那些 uid（实测 994~999 / 19000 / 真实 10、11、12）
# 上会回空或直接报错，daemon 就永远翻不出包名，服务端只能退回按别名/槽位猜 —— 而那些机器
# 的槽位往往一直标不上，就卡死了。这张表不依赖那个服务：系统的 packages.list 里分身自己那一行
# 本来就在（999xxxxx），反着抄一遍就是 uid→包名。
# 只在源文件变了的时候重写，不然每轮白抄上千行。
sync_uid_packages() {
  [ -r "$PACKAGES_LIST" ] || return 0
  local stamp
  stamp=$(ls -l "$PACKAGES_LIST" 2>/dev/null | awk '{print $5"-"$6"-"$7"-"$8}')
  if [ -f "$UID_PACKAGES_OUT" ] && [ -n "$stamp" ] \
    && [ "$stamp" = "$(cat "$UID_PACKAGES_OUT.stamp" 2>/dev/null)" ]; then
    return 0
  fi
  local tmp="$UID_PACKAGES_OUT.tmp"
  {
    echo "# uid package (from $PACKAGES_LIST)"
    while read -r pkg uid _rest; do
      [ -n "$pkg" ] && [ -n "$uid" ] && echo "$uid $pkg"
    done < "$PACKAGES_LIST"
  } > "$tmp" 2>/dev/null || return 0
  chmod 0644 "$tmp" 2>/dev/null
  mv -f "$tmp" "$UID_PACKAGES_OUT" 2>/dev/null || return 0
  echo "$stamp" > "$UID_PACKAGES_OUT.stamp" 2>/dev/null
  # 再给载荷（宿主域）留一份读得动的：它就在转发 SOTER 那一步自己翻包名。
  cp -f "$UID_PACKAGES_OUT" "$UID_PACKAGES_COPY" 2>/dev/null
  chmod 0644 "$UID_PACKAGES_COPY" 2>/dev/null
  chcon u:object_r:system_data_file:s0 "$UID_PACKAGES_COPY" 2>/dev/null
}

# root 侧写下「当前前台应用」（一行 `<epoch 秒> <包名>`）给 daemon 做最后一道兜底：
# 内核 uid 翻不出包名（分身/空间/多用户那类机器）时，daemon 就用它。
# 这件事比读文件贵（要跑一次 dumpsys），所以只每 FOREGROUND_EVERY 拍干一次。
# 采不到就保留上一份 —— daemon 那边带新鲜度阀，旧了它自己不用。
sync_foreground() {
  local pkg tmp now
  # 两条路都试：不同 ROM 用的字段不一样（实测 nubia 是 mCurrentFocus / topResumedActivity，
  # 老的是 mResumedActivity）。取包名的 sed 是贪心的 —— 一行里可能有 Window{hash u0 pkg/cls}
  # 这种，要的是最后一个 `pkg/` 前的包名。
  pkg=$(dumpsys window displays 2>/dev/null | grep -m1 mCurrentFocus \
    | sed -n 's/.* \([a-zA-Z0-9_][a-zA-Z0-9_.]*\)\/[^ }]*.*/\1/p')
  if [ -z "$pkg" ]; then
    pkg=$(dumpsys activity activities 2>/dev/null \
      | grep -m1 -E "topResumedActivity|mResumedActivity" \
      | sed -n 's/.* \([a-zA-Z0-9_][a-zA-Z0-9_.]*\)\/[^ }]*.*/\1/p')
  fi
  [ -n "$pkg" ] || return 0
  now=$(date +%s 2>/dev/null) || return 0
  tmp=$FOREGROUND_OUT.tmp
  echo "$now $pkg" > "$tmp" 2>/dev/null || return 0
  chmod 0644 "$tmp" 2>/dev/null
  mv -f "$tmp" "$FOREGROUND_OUT" 2>/dev/null
  cp -f "$FOREGROUND_OUT" "$FOREGROUND_COPY" 2>/dev/null
  chmod 0644 "$FOREGROUND_COPY" 2>/dev/null
  chcon u:object_r:system_data_file:s0 "$FOREGROUND_COPY" 2>/dev/null
}

# 把 injector.toml 抄一份到 app 域读得到的地方（载荷的 config 优先读主路径，读不到就用这份）。
# 只在内容变了才写，省得每拍白抄。
sync_injector_toml() {
  [ -r "$INJECTOR_TOML" ] || return 0
  cmp -s "$INJECTOR_TOML" "$INJECTOR_TOML_COPY" 2>/dev/null && return 0
  local tmp="$INJECTOR_TOML_COPY.tmp"
  cp -f "$INJECTOR_TOML" "$tmp" 2>/dev/null || return 0
  chmod 0644 "$tmp" 2>/dev/null
  chcon u:object_r:system_data_file:s0 "$tmp" 2>/dev/null
  mv -f "$tmp" "$INJECTOR_TOML_COPY" 2>/dev/null
}

restart_keystore() {
  local pid
  pid=$1
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    log "[injector-daemon] restart requested; stopping keystore2 pid=$pid"
    kill -TERM "$pid" 2>/dev/null
    sleep 2
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null
    fi
  fi
}

mkdir -p "$STATE_DIR"
LOG_ON=0
soter_ask_changed=0
pending_restart=0
last_attempt_pid=
last_attempt_at=0
retry_cooldown=15
soter_start_attempted=0
# 宿主保活用的节流：宿主不在时最多每 30 秒拉起一次，别每拍都去 am start-service。
last_soter_start_at=0
# 第一次看到「宿主在跑但没注上」的时刻（epoch 秒），注完把间隔写进日志。
soter_seen_at=
last_soter_pid=
last_soter_attempt_at=0

# 开机头 90 秒里紧凑轮询（3 秒一次）：keystore2 一出现就注上，别等 5 秒的节拍。
# 因为框架的 onDeviceUnlocked 只有你解锁那一刻一次、从不补发 —— 那一瞬间我们不在
# keystore2 里，这份解锁材料就永久丢了（影子 keystore 会一直 LOCKED 到下次解锁）。
EARLY_POLL_SECONDS=90
started_at=$(date +%s 2>/dev/null || echo 0)
# 主循环的拍数：前台那个活代价比读文件大，没必要每拍都干（见 sync_foreground）。
tick=0
# 前台应用多久采一次（拍数）。5 秒一拍 × 2 = 约 10 秒；daemon 那边认 20 秒内的，所以
# 任何时候它读到的那份最多 10 秒旧——之前是 3 拍（≈15 秒）写一次、只认 8 秒，大部分时候
# 都是“过期的没有”，等于这一道不存在。
FOREGROUND_EVERY=2
tick_sleep() {
  now=$(date +%s 2>/dev/null)
  if [ -n "$now" ] && [ "$started_at" -gt 0 ] && [ $((now - started_at)) -lt $EARLY_POLL_SECONDS ]; then
    sleep 3
  else
    sleep 5
  fi
}

while true; do
  # Config and target list live in the single data location
  # (/data/misc/keystore/ommega/); the webroot UI writes them through the
  # ommegadata symlink, so no copy/sync is needed here.

  LOG_ON=0
  debug_logging_enabled && LOG_ON=1
  sync_log_flag
  sync_uid_packages
  sync_injector_toml
  if [ $((tick % FOREGROUND_EVERY)) -eq 0 ]; then
    sync_foreground
  fi
  tick=$((tick + 1))
  sync_soter_ask
  sync_soter_cpu_id
  if [ "$soter_ask_changed" = "1" ]; then
    restart_soter_host
  fi

  if ! prepare_injector; then
    tick_sleep
    continue
  fi

  if consume_restart_request; then
    pending_restart=1
    restart_keystore "$(get_keystore_pid)"
    if ! prepare_injector; then
      tick_sleep
      continue
    fi
  fi

  # 注入目标跟着 WebUI 开关走：关着只有 keystore2（主路），开着再加上 SOTER 宿主。
  # 开关是热读的，WebUI 一改下一次循环就生效（注入本身仍在目标起来之后）。
  inject_targets=keystore2
  if soter_inject_enabled; then
    inject_targets=keystore2,soter
    # daemon 判出「宿主哑了」时会把结论写进那个标记文件（见 a 端 src/soter_host_health.rs：
    # 宿主收得到 App 侧调用、却一笔都不往 HAL 发，我们的接管因此没东西可拦，App 那边一直报
    # 「系统错误」；2026-10-09 nubia NX721J 上微信指纹支付卡住的就是这个）。
    # 动手的只能是这里：daemon 在 keystore uid 里，杀不动 system 域的宿主。
    # 踢完立刻拉一个新的，不走下面保活那 30 秒节流 —— 用户这时候多半正卡在微信里重试。
    if [ -f "$SOTER_STUCK_FILE" ]; then
      reason=$(head -n1 "$SOTER_STUCK_FILE" 2>/dev/null)
      rm -f "$SOTER_STUCK_FILE" 2>/dev/null
      log "[injector-daemon] ${reason:-$SOTER_PKG looks mute}"
      restart_soter_host "so a fresh HAL client comes up"
      start_soter_service
    fi
    # 宿主保活：不在就再拉一次（不是只在开机那一次）。
    #
    # 为什么要这样：App 是 bind 到宿主时才把它拉起来的，而它一被拉起来就**马上**发第一笔
    # SOTER —— 实测那台小米：请求 08:18:28 发出去、08:18:32 我们才把载荷注进去，那四秒里
    # 全透传真 HAL。而宿主被系统杀掉后我们原来不会再去拉它，只能等 App 下次把它拉起来，
    # 于是每次都碰上“刚起来的宿主 + 还没进去的载荷”。常态让它跑着（带节流，免得刷日志），
    # App 来调的时候宿主里就已经有载荷了。
    if [ -z "$(soter_pid)" ]; then
      now_start=$(date +%s 2>/dev/null)
      if [ -z "$now_start" ] || [ "$now_start" -ge $((last_soter_start_at + 30)) ]; then
        last_soter_start_at=${now_start:-0}
        start_soter_service
      fi
    fi
  else
    # 开关关着：宿主里根本没有载荷，这个标记已经没意义 —— 留着只会在下次
    # 打开开关时平白重启一次宿主。
    rm -f "$SOTER_STUCK_FILE" 2>/dev/null
  fi

  pid=$(get_keystore_pid)
  keystore_pending=0
  if [ -z "$pid" ]; then
    last_attempt_pid=
  elif ! is_injected "$pid"; then
    keystore_pending=1
  fi

  spid=$(soter_pid)
  soter_pending=0
  if [ "$inject_targets" != "keystore2" ] && [ -n "$spid" ] && ! is_injected "$spid"; then
    soter_pending=1
    # 第一眼看到“在跑但没注上”的时刻：注完算间隔用。
    [ -n "$soter_seen_at" ] || soter_seen_at=$(date +%s 2>/dev/null)
  else
    soter_seen_at=
  fi

  if [ "$keystore_pending" -eq 0 ] && [ "$soter_pending" -eq 0 ]; then
    pending_restart=0
    last_attempt_pid=
    last_soter_pid=
    tick_sleep
    continue
  fi

  # 同一个目标连着注失败就缓一下，别每 5 秒拿 ptrace 去戳一次。
  now=$(date +%s 2>/dev/null)
  if [ -n "$now" ] && [ "$pending_restart" -eq 0 ]; then
    if [ "$keystore_pending" -eq 1 ] && [ "$last_attempt_pid" = "$pid" ] \
      && [ "$now" -lt $((last_attempt_at + retry_cooldown)) ]; then
      tick_sleep
      continue
    fi
    # 宿主换了 pid（刚重启）就不吃冷却：那个空窗就压在这里 —— 立刻注，不等 retry_cooldown。
    if [ "$soter_pending" -eq 1 ] && [ "$last_soter_pid" = "$spid" ] \
      && [ "$now" -lt $((last_soter_attempt_at + retry_cooldown)) ]; then
      tick_sleep
      continue
    fi
  fi

  # Clear a stale inject instance (exact binary path) before injecting, so a
  # leftover injector from a previous run cannot coexist with the new one.
  pkill -9 -f "$TARGET_INJECTOR" 2>/dev/null
  sleep 1
  if [ "$keystore_pending" -eq 1 ]; then
    log "[injector-daemon] injecting into keystore2 pid=$pid via $TARGET_INJECTOR"
  else
    gap=""
    if [ -n "$soter_seen_at" ]; then
      gap=" gap=$(( $(date +%s 2>/dev/null || echo 0) - soter_seen_at ))s"
    fi
    log "[injector-daemon] injecting into $SOTER_PKG pid=$spid via $TARGET_INJECTOR$gap"
  fi
  OMMEGA_INJECT_TARGETS="$inject_targets" "$TARGET_INJECTOR"
  rc=$?
  last_attempt_pid=$pid
  last_attempt_at=$(date +%s 2>/dev/null)
  last_soter_pid=$spid
  last_soter_attempt_at=$last_attempt_at
  pending_restart=0
  log "[injector-daemon] injector exited with code $rc"
  sleep 3
done
