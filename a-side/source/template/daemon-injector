#!/system/bin/sh

MODDIR=${OMMEGA_MODDIR:-/data/adb/modules/ommega}

# 把自己 comm 改成伪装名：injector 的 exe 是系统 sh，comm 默认也是 sh，跟系统里
# 几百个 sh 混在一起没法认 —— 守护就没办法靠 comm 判断「我已经在跑了」，
# 结果每 5 秒又拉一个（实测摞到五个，两个各烧了几十秒 CPU）。改完 ps 里也好看了。
_inj_tag=$(sed -n 's/^injector=//p' /data/misc/ommega/conf/stealth.names 2>/dev/null | head -n 1)
if [ -n "$_inj_tag" ]; then
  printf '%s' "${_inj_tag##*/}" | cut -c1-15 > /proc/$$/comm 2>/dev/null
fi
STATE_DIR=/data/adb/ommega
CONF_DIR=$STATE_DIR/conf
RUN_DIR=$STATE_DIR/run
DB_DIR=$STATE_DIR/db
[ -f "$MODDIR/layout.sh" ] && . "$MODDIR/layout.sh" 2>/dev/null
PAYLOAD_STATE_FILE=$CONF_DIR/injector.payload
RESTART_FILE=$RUN_DIR/restart.injector
PEER_RESTART_FILE=$RUN_DIR/restart.keymint
RESTART_ALL_FILE=$RUN_DIR/restart.all

# A 端平铺 config（WebUI 写的），只有 soter_inject 这个键是本脚本读的：
# 关着（键不在、或写了 0/false）就完全不碰 SOTER 宿主——不起服务、不注入；
# 开着才 `am start-service` 把它拉起来再注进去。
CONF_PATH=${OMMEGA_CONF_PATH:-/data/misc/ommega/config}
# 日志开关的副本：payload 有可能落进读不到上面那个配置的域（SOTER 宿主是 uid 1000），
# 它按这个文件决定写不写日志。内容只有 `log_flag: 0|1` 一行，别往里放别的。
# 放 /data/misc 下面是因为宿主（system_app）连 /data/adb（0700 root）都进不去，
# 而这里的 context 是 system_data_file，它读得到。
LOG_FLAG=${OMMEGA_LOG_FLAG_PATH:-/data/misc/ommega/log_flag}
# root 侧写给 daemon 的「uid → 包名」表（它就从系统自己的 packages.list 抄）。
# daemon 跑在 keystore uid，这文件在共享数据根里，它和宿主的 payload 读的是一份。
UID_PACKAGES_OUT=/data/misc/ommega/uid_packages
PACKAGES_LIST=/data/system/packages.list
# daemon 拿去做最后一道兜底的「当前前台应用」。
FOREGROUND_OUT=/data/misc/ommega/foreground
# 载荷读的配置。数据根已经统一到 /data/misc/ommega，keystore 域和 SOTER 宿主域
# 读的是同一个文件，不再有「抄一份给宿主」的副本和那轮 cp。
INJECTOR_TOML=/data/misc/ommega/injector.toml
LOG_FLAG_DIR=$(dirname "$LOG_FLAG")
# 本脚本自己的日志，只落文件（以前是 echo，会进管理器的 service 日志）。
LOG_DIR=/data/misc/ommega/logs
LOG_FILE=$LOG_DIR/daemon.log
# app 域里那份 payload（SOTER 宿主 uid 1000）写不进上面那个 keystore 目录，
# 得给它一个自己写得动的位置，权限开到 system 组。
APP_LOG_DIR=$LOG_FLAG_DIR/logs
# 换本地兜底 ATTK 的通道：往真配置目录里放一份 soter_attk.pem（PKCS#8 PEM），
# 这里抄到 app 域读得到的位置，再把 SOTER 宿主踢一次让新 key 生效。
SOTER_ATTK_DST=/data/misc/ommega/soter_attk.pem
# daemon 学到的真机 cpu_id：它自己那份写在 keystore 域（它跑在 keystore uid 里，别处
# 写不动），这里抄到 app 域给宿主里那份 payload 读。内容就一行 `soter_cpu_id: <32 hex>`。
SOTER_CPU_ID_DST=/data/misc/ommega/soter_cpu_id
# ATTK 文件里可以带一行 `cpu_id: 09000000…`：导入时顺手写这里，
# 免得 ATTK 换了、cpu_id 还是上一台的，腾讯一对不上就拒。
SOTER_CPU_FORCE_DST=/data/misc/ommega/soter_cpu_id.force
SOTER_PKG=com.tencent.soter.soterserver
SOTER_ACTION=$SOTER_PKG.ISoterService
# daemon 判出「SOTER 宿主哑了」时写的标记（`src/soter_host_health.rs`）：写一行原因，
# 这里读走、删掉，再把宿主换成新实例。daemon 跑在 keystore uid，能写这个目录靠的是
# sepolicy.rule 里给 keystore 域的 system_data_file 写权限。
SOTER_STUCK_FILE=/data/misc/ommega/soter_host_stuck
# soterta.sh 算完落盘的「这台是不是 HIDL 平台」（0/1）。
HIDL_CACHE=$STATE_DIR/conf/soter_hidl_platform
# root 侧判出来的宿主体检结论（stub / real），见 sync_soter_host_state。
SOTER_HOST_STATE_OUT=/data/misc/ommega/soter_host_state

# Resolve the device ABI.  One module zip now carries every ABI at once, so
# libs/<abi> has to be picked by what this device actually runs; falling back
# to directory order would hand an x86_64 device the arm64 binary.
device_abi() {
  local abi
  abi="$(getprop ro.product.cpu.abi 2>/dev/null)"
  [ -n "$abi" ] || abi="$(uname -m 2>/dev/null)"
  case "$abi" in
    arm64*|aarch64*) echo arm64-v8a ;;
    armeabi*|armv7*) echo armeabi-v7a ;;
    x86_64*) echo x86_64 ;;
    i?86|x86) echo x86 ;;
    *) echo "" ;;
  esac
}

find_module_injector() {
  # 唯一位置：模块内 `libs/<abi>/ommega-inject`。
  # 不搜模块根、不遍历其它 ABI：那都会在打包残缺时静默选错架构的二进制。
  local abi
  abi=$(device_abi)
  if [ -n "$abi" ] && [ -f "$MODDIR/libs/$abi/ommega-inject" ]; then
    echo "$MODDIR/libs/$abi/ommega-inject"
    return 0
  fi
  return 1
}

prepare_injector() {
  TARGET_INJECTOR=$(find_module_injector)
  if [ -z "$TARGET_INJECTOR" ]; then
    log "[injector-daemon] injector binary not found"
    return 1
  fi

  chmod 0755 "$TARGET_INJECTOR" 2>/dev/null || true
  chcon u:object_r:system_file:s0 "$TARGET_INJECTOR" 2>/dev/null || true
  if [ ! -x "$TARGET_INJECTOR" ]; then
    log "[injector-daemon] injector binary missing or not executable: $TARGET_INJECTOR"
    return 1
  fi
  return 0
}

expand_shared_restart() {
  if [ -f "$RESTART_ALL_FILE" ]; then
    : > "$RESTART_FILE"
    : > "$PEER_RESTART_FILE"
    rm -f "$RESTART_ALL_FILE"
  fi
}

consume_restart_request() {
  expand_shared_restart

  if [ -f "$RESTART_FILE" ]; then
    rm -f "$RESTART_FILE"
    return 0
  fi

  return 1
}

get_keystore_pid() {
  pidof keystore2 2>/dev/null | awk '{print $1}'
}

conf_get() {
  [ -f "$CONF_PATH" ] || return 0
  sed -n "s/^[[:space:]]*$1[[:space:]]*:[[:space:]]*\(.*\)$/\1/p" "$CONF_PATH" 2>/dev/null | head -n1
}

# 0 = WebUI 「注入 SOTER 服务」开着。键不在（全新安装的默认）就是关，所以只有显式
# 写了真值才认；WebUI 写的是 1/0，手写的 true/on 也认。
soter_inject_enabled() {
  case "$(conf_get soter_inject | tr 'A-Z' 'a-z' | tr -d ' \r')" in
    1|true|yes|on) return 0 ;;
  esac
  return 1
}

# 这台是不是 HIDL 平台：读 soterta.sh 算完落盘的那份缓存（0/1），不再每拍 fork 一次。
soter_hidl_platform() {
  [ -f "$HIDL_CACHE" ] || return 1
  case "$(cat "$HIDL_CACHE" 2>/dev/null | tr -d ' \r\n')" in
    1) return 0 ;;
  esac
  return 1
}

# 要不要把载荷注进 SOTER 宿主。只有两种机器需要：
#   * HIDL 平台：客户端走 hwservicemanager，那个名字我们顶不了，只能注进宿主截它发往
#     HAL 的调用；
#   * 宿主是壳：它压根不发 HAL 请求，得在它进程里替它答 App（见 sync_soter_host_state）。
# 正常宿主的 AIDL 机器不注 —— 跟以前一样，省一次 ptrace，也不给宿主添每秒一次 HAL 自检
# 的流量（那个自检会把原厂懒加载 HAL 叫起来抢服务名）。
soter_host_needs_payload() {
  soter_hidl_platform && return 0
  case "$(cat "$SOTER_HOST_STATE_OUT" 2>/dev/null | tr -d ' \r\n')" in
    stub) return 0 ;;
  esac
  return 1
}

# 日志只落文件。「启用调试日志」关着时一条都不打，开关按循环现读，WebUI 一改
# 下一次循环就跟着变。
log() {
  [ "$LOG_ON" = "1" ] || return 0
  mkdir -p "$LOG_DIR" 2>/dev/null
  # daemon.log 是所有 A 端脚本共用一份的，超过 1MB 滚成 .1，别让它无限长。
  if [ -f "$LOG_FILE" ] && [ "$(stat -c %s "$LOG_FILE" 2>/dev/null || echo 0)" -gt 1048576 ]; then
    mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null
  fi
  printf '%s [INFO] %s\n' "$(date -u '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE" 2>/dev/null
  return 0
}

# 0 = 「启用调试日志」开着。键不在或写了假值都算关。
debug_logging_enabled() {
  case "$(conf_get debug_logging | tr 'A-Z' 'a-z' | tr -d ' \r')" in
    1|true|yes|on) return 0 ;;
  esac
  return 1
}

# 把开关落成一行给 payload 看（内容没变就不动文件，别每 5 秒写一次）。
sync_log_flag() {
  want=0
  debug_logging_enabled && want=1
  # 目录本身的属主/权限/SELinux 标签、以及目录里那几个日志文件的标签，都不会自己变。
  # 以前每轮（3~5 秒）都无条件重做一遍 mkdir+chown+chmod+chcon，再加每个文件一次
  # chcon —— 十几次 fork，全是在确认“没变”。现在用「目录属性 + mtime」当签名，
  # 只在目录被重建、文件增删这类真正需要修的情况下才跑那一段。
  local app_sig
  app_sig=$(stat -c '%u:%g:%a:%Y' "$APP_LOG_DIR" 2>/dev/null)
  if [ "$app_sig" != "${LOG_FLAG_SIG:-}" ]; then
    # app 域那几个（SOTER 宿主里那份 payload）要用这个目录；顺手建掉，内容没变
    # 的时候也不多做别的事。
    mkdir -p "$APP_LOG_DIR" 2>/dev/null
    chown 0:1000 "$APP_LOG_DIR" 2>/dev/null
    # 1777 是给 SOTER 宿主留的：红魔上它是 system(1000)（组权限就够），一加 PLC110
    # 上它是 u0_a292(10292) —— 既不是属主也不在 system 组，只有 other 那一档能救。
    # sticky 位挡住删掉 / 改名别人的日志文件（否则谁都能把 injector.log 换成软链，
    # 等 keystore 域往里 append 的时候写穿到别处）。
    chmod 1777 "$APP_LOG_DIR" 2>/dev/null
    # 标签得是 system_app_data_file。默认继承下来的 system_data_file 下面，
    # system_app（SOTER 宿主 uid 1000）连自己属主的日志文件都开不了写，那份日志
    # 会整条哑掉；换成 system_app_data_file 才写得动。启动时的 restorecon 会把
    # 它改回去，所以这里要能补；但只有目录重建/新文件时才有必要补。
    chcon u:object_r:system_app_data_file:s0 "$APP_LOG_DIR" 2>/dev/null
    for f in "$APP_LOG_DIR"/*; do
      [ -f "$f" ] && chcon u:object_r:system_app_data_file:s0 "$f" 2>/dev/null
    done
    LOG_FLAG_SIG=$app_sig
  fi
  # 那份日志是先到的那个进程建的（HAL 是 system(1000)，宿主是一加上的 u0_a292(10292)），
  # 属主只有一个，另一个只能靠 other 那一档写。这里统一放到 0666，谁续写都行；
  # 里面只有我们自己的调试日志，不怕被读。文件不在就先放一个空的。
  APP_LOG_FILE=$APP_LOG_DIR/injector.log
  SIGN_OK_FILE=$LOG_FLAG_DIR/soter_ok
  # 这四个路径的「属主/权限」当签名：全都对就一个 fork 的 stat 完事，
  # 有一样跑偏（被 restorecon 动了、用户改过、升上来的旧版、文件或目录被删重建）才进去修。
  # 特意不带 mtime：日志文件每写一行 mtime 就变，带上就等于每拍都跑那段修复。
  # 目录被重建的情况靠 mode 能认出来 —— 新建的目录是 0755，而我们要的是 1777 / 0711。
  local fix_sig
  fix_sig=$(stat -c '%n:%u:%g:%a' "$APP_LOG_DIR" "$APP_LOG_FILE" "$SIGN_OK_FILE" "$LOG_FLAG_DIR" 2>/dev/null)
  if [ "$fix_sig" != "${PERM_SIG:-}" ]; then
    [ -f "$APP_LOG_FILE" ] || : > "$APP_LOG_FILE" 2>/dev/null
    chmod 0666 "$APP_LOG_FILE" 2>/dev/null
    chcon u:object_r:system_app_data_file:s0 "$APP_LOG_FILE" 2>/dev/null
    [ -f "$SIGN_OK_FILE" ] || : > "$SIGN_OK_FILE" 2>/dev/null
    chmod 0666 "$SIGN_OK_FILE" 2>/dev/null
    chcon u:object_r:system_app_data_file:s0 "$SIGN_OK_FILE" 2>/dev/null
    mkdir -p "$LOG_FLAG_DIR" 2>/dev/null
    # 这个目录里可能放着用户自己替换的 soter_attk.pem（本地兜底的签名根），
    # 所以不能让 other 进得来读：属主给 system(1000) 是因为 app 域的 payload
    # 要进来读开关和钥匙。
    chown 0:1000 "$LOG_FLAG_DIR" 2>/dev/null
    # 0711：other 只给穿越权，不给列目录权 —— 上面那个 soter_attk.pem（本地兜底
    # 私钥，0640）还在别的权限保护着，列不出来也读不到；但宿主得能穿过这一层去
    # 写 logs/，所以 x 必须给。
    chmod 0711 "$LOG_FLAG_DIR" 2>/dev/null
    PERM_SIG=$fix_sig
  fi
  sog_size=$(stat -c %s "$SIGN_OK_FILE" 2>/dev/null)
  case "$sog_size" in
    ''|*[!0-9]*) : ;;
    *) [ "$sog_size" -gt 65536 ] && : > "$SIGN_OK_FILE" 2>/dev/null ;;
  esac
  cur=$(sed -n 's/^log_flag:[[:space:]]*//p' "$LOG_FLAG" 2>/dev/null | head -n1 | tr -d ' \r')
  if [ "$cur" != "$want" ]; then
    printf 'log_flag: %s\n' "$want" > "$LOG_FLAG" 2>/dev/null
    # 0644 而不是 0640：一加 PLC110 上宿主是 u0_a292(10292)，不在 system 组里，
    # 0640 它读不到 —— 开关读不到就等于关着，它那份日志永远不会写出来。
    # 内容就一行 log_flag，不算秘密。
    chmod 0644 "$LOG_FLAG" 2>/dev/null
  fi
}

soter_pid() {
  pidof "$SOTER_PKG" 2>/dev/null | awk '{print $1}'
}

# 配置目录里的 soter_attk.pem 变过就抄一份到 app 域能读的位置（宿主进不去 keystore
# 目录）。抄完置 soter_attk_changed=1，主循环把宿主踢掉重来。
sync_soter_attk() {
  soter_attk_changed=0
  src=$(dirname "$CONF_PATH")/soter_attk.pem

  # 源没了就回到 payload 里编进去的那把。数据根合并后 src 和 dst 是同一个文件，
  # 拿 dst 存在与否判断没用（都没有）—— 只能看 stamp：它记着「上次生效的是外部那把」，
  # 还在就说明刚才被面板撤了，这一轮才算变化。
  if [ ! -f "$src" ]; then
    if [ -f "$CONF_DIR/soter_attk.stamp" ]; then
      rm -f "$CONF_DIR/soter_attk.stamp" 2>/dev/null
      rm -f "$SOTER_ATTK_DST" 2>/dev/null
      # ATTK 里带的 cpu_id 也得跟着没：那是「跟着这把 ATTK 走」的强制值，
      # 回到内置之后应该重新用真机自己的号。
      rm -f "$SOTER_CPU_FORCE_DST" 2>/dev/null
      soter_attk_changed=1
      log "[injector-daemon] local soter attk removed; back to the built-in key"
    fi
    return 0
  fi

  # 数据根合并之后 src 和 dst 常常是**同一个文件**（都是 /data/misc/ommega/soter_attk.pem），
  # 这时 `-nt` 恒为 false，ATTK 换了也检测不出来 —— WebUI 导入新私钥不生效就是这么来的。
  # 改成记住上次处理时的「大小:mtime」，变了才算变化。
  stamp=$CONF_DIR/soter_attk.stamp
  cur=$(stat -c '%s:%Y' "$src" 2>/dev/null)
  [ -n "$cur" ] || return 0
  if [ -f "$stamp" ] && [ "$(cat "$stamp" 2>/dev/null)" = "$cur" ]; then
    return 0
  fi

  # 不同路径才需要搬；同一份文件就别 cp 了（会报 same file）。
  if [ "$src" != "$SOTER_ATTK_DST" ]; then
    if ! cp -f "$src" "$SOTER_ATTK_DST" 2>/dev/null; then
      log "[injector-daemon] failed to copy $src to $SOTER_ATTK_DST"
      return 0
    fi
  fi

  # 640 而不是 644：这是私钥。app 域的 payload 是 uid 1000，靠 system
  # 组权限读得到，其他 app 就不行了。
  chown 0:1000 "$SOTER_ATTK_DST" 2>/dev/null
  chmod 0640 "$SOTER_ATTK_DST" 2>/dev/null
  soter_attk_changed=1
  log "[injector-daemon] local soter ask loaded from $src"
  # 文件里带了 cpu_id 就跟着设 force：ATTK 和 cpu_id 必须是同一台设备的，
  # 不然腾讯验 ASK 时对不上直接拒（2026-10-30 实测）。
  cpu=$(sed -n 's/^[[:space:]]*#\{0,1\}[[:space:]]*cpu_id:[[:space:]]*\([0-9a-fA-F]\{32\}\)[[:space:]]*$/\1/p' "$src" 2>/dev/null | head -n 1)
  if [ -n "$cpu" ]; then
    if printf '%s\n' "$cpu" > "$SOTER_CPU_FORCE_DST" 2>/dev/null; then
      chown 0:0 "$SOTER_CPU_FORCE_DST" 2>/dev/null
      chmod 0644 "$SOTER_CPU_FORCE_DST" 2>/dev/null
      log "[injector-daemon] cpu_id forced from $src: $cpu"
    else
      log "[injector-daemon] failed to write $SOTER_CPU_FORCE_DST"
    fi
  fi
  mkdir -p "$CONF_DIR" 2>/dev/null
  printf '%s' "$cur" > "$stamp" 2>/dev/null
}

# 真机 cpu_id 镜像到 app 域。不删旧件：源不在只说明「daemon 还没学到」（B 端不在线、
# 或者刚装完还没跑完第一轮），把上一回学到的号删掉只会让本地兜底退回去用派生的假号 ——
# 那正是检测器报「两次 cpuid 不一致」的根。
#
# 不需要踢 SOTER 宿主：payload 每 30 秒看一眼这个文件，换了号下一次调用就跟上。
sync_soter_cpu_id() {
  src=$(dirname "$CONF_PATH")/soter_cpu_id
  [ -f "$src" ] || return 0
  # 数据根合并后 src 就是 dst（同一个文件），没有「镜像」这回事，直接读完事。
  [ "$src" = "$SOTER_CPU_ID_DST" ] && return 0

  # 同样用 mtime 快路径（零 fork）代替两次 cat。
  if [ -f "$SOTER_CPU_ID_DST" ] && [ ! "$src" -nt "$SOTER_CPU_ID_DST" ]; then
    return 0
  fi

  if cp -f "$src" "$SOTER_CPU_ID_DST" 2>/dev/null; then
    # 644：这个号不是秘密（App 走 SOTER 本来就看得到），而宿主在红魔上是 uid 1000、
    # 一加上是 u0_a292(10292) —— 属主给 0、组给不到它头上，只有 other 那一档人人读得到。
    chown 0:0 "$SOTER_CPU_ID_DST" 2>/dev/null
    chmod 0644 "$SOTER_CPU_ID_DST" 2>/dev/null
    log "[injector-daemon] device cpu_id mirrored from $src"
  else
    log "[injector-daemon] failed to mirror $src to $SOTER_CPU_ID_DST"
  fi
}

# 换 key 之后把 SOTER 宿主停掉：key 是进程启动时加载的，它下一次被 bind 起来
# 的时候会重新加载。
#
# 自愈也用这个：宿主「哑了」（收得到 App 侧调用、却一笔都不往 HAL 发）只有换实例才救得回来。
# 第二个参数是日志里那句理由：不说清的话，两种场景在日志里长得一样。
restart_soter_host() {
  # pid 必须是局部的：它跟主循环那个 keystore2 的 pid 同名，不声明 local 就会把循环里的
  # 目标冲成 SOTER 宿主的 pid（日志打错 pid，重试冷却也失效）。
  local pid reason
  reason=${1:-"so the new soter ask takes effect"}
  pid=$(soter_pid)
  [ -n "$pid" ] || return 0
  log "[injector-daemon] stopping $SOTER_PKG pid=$pid $reason"
  kill -TERM "$pid" 2>/dev/null
  sleep 2
  kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
  return 0
}

# 本地签名自检：给面板一个「加载就有的结论」—— 用当前生效的 ASK 签一段固定文本
# 再验一遍。纯本地密码学（微秒级），**不碰网络也不碰 TEE**，所以不会挡任何签名
# 路径。跑不动（超时/报错/找不到二进制）就当没结论，一声不吐；下次循环再试。
run_soter_selftest() {
  sog_bin=${TARGET_INJECTOR:-}
  [ -n "$sog_bin" ] || sog_bin=$(find_module_injector 2>/dev/null)
  [ -n "$sog_bin" ] && [ -x "$sog_bin" ] || return 0
  sog_out=$(timeout 3 "$sog_bin" --soter-selftest 2>/dev/null | head -n1)
  [ "$sog_out" = "ok" ] || return 0
  sog_now=$(date +%s 2>/dev/null)
  case "$sog_now" in
    ''|*[!0-9]*) return 0 ;;
  esac
  printf '%s\tselftest\t0\t-\n' "$sog_now" >> "$SIGN_OK_FILE" 2>/dev/null
  sog_once=1
  log "[injector-daemon] local soter selftest ok (signed and verified locally)"
}

# SOTER 宿主是 bind-only 的服务：没人要就不起来，所以开关开着时得替客户端先喊一声。
# 拉不起来只记一行、不死循环重试（启动失败通常是系统那边的问题，本模块管不了）。
start_soter_service() {
  log "[injector-daemon] soter_inject on; starting $SOTER_PKG"
  am start-service -a "$SOTER_ACTION" >/dev/null 2>&1
  i=0
  while [ -z "$(soter_pid)" ] && [ "$i" -lt 20 ]; do
    sleep 0.5
    i=$((i + 1))
  done
  [ -n "$(soter_pid)" ] || log "[injector-daemon] $SOTER_PKG did not come up"
}

is_injected() {
  # 同上：调用方会用 keystore2 的 pid / SOTER 的 pid 各叫一次，局部化才不会互相覆盖。
  local pid maps
  pid=$1
  maps=/proc/$pid/maps
  [ -r "$maps" ] || return 1

  if [ -r "$PAYLOAD_STATE_FILE" ]; then
    # 状态文件里是 `<pid> <memfd 名字>`（载荷走 memfd，名字是每轮随机生成的
    # `lib<32hex>.so`，磁盘上算不出来，只能从这儿拿）。同一个 pid 可能留了好几行，
    # 取最后一条。
    #
    # 这里**不能**写 `toybox awk`：这台机器（nubia NX721J）的 toybox 没有 awk 这个
    # applet，整段判据静默失败，于是每轮都判「没注上」、每 16 秒重新 ptrace 注一遍
    # ——实测这个循环会让 MT 管理器刷根目录卡住十来秒、只显示普通权限那份列表。
    # 用纯 shell，不依赖 awk。
    local ident line_pid line_ident
    ident=""
    while read -r line_pid line_ident _rest; do
      [ "$line_pid" = "$pid" ] || continue
      [ -n "$line_ident" ] && ident=$line_ident
    done < "$PAYLOAD_STATE_FILE"

    if [ -n "$ident" ] && grep -qF "$ident" "$maps" 2>/dev/null; then
      return 0
    fi
  fi

  grep -F "$TARGET_INJECTOR" "$maps" >/dev/null 2>&1 && return 0
  return 1
}

# root 侧把「uid → 包名」抄一份给 daemon。
#
# 为什么要它：AAID 服务在分身/空间/多用户那些 uid（实测 994~999 / 19000 / 真实 10、11、12）
# 上会回空或直接报错，daemon 就永远翻不出包名，服务端只能退回按别名/槽位猜 —— 而那些机器
# 的槽位往往一直标不上，就卡死了。这张表不依赖那个服务：系统的 packages.list 里分身自己那一行
# 本来就在（999xxxxx），反着抄一遍就是 uid→包名。
# 只在源文件变了的时候重写，不然每轮白抄上千行。
sync_uid_packages() {
  [ -r "$PACKAGES_LIST" ] || return 0
  local stamp
  stamp=$(ls -l "$PACKAGES_LIST" 2>/dev/null | awk '{print $5"-"$6"-"$7"-"$8}')
  if [ -f "$UID_PACKAGES_OUT" ] && [ -n "$stamp" ] \
    && [ "$stamp" = "$(cat "$UID_PACKAGES_OUT.stamp" 2>/dev/null)" ]; then
    return 0
  fi
  local tmp="$UID_PACKAGES_OUT.tmp"
  {
    echo "# uid package (from $PACKAGES_LIST)"
    while read -r pkg uid _rest; do
      [ -n "$pkg" ] && [ -n "$uid" ] && echo "$uid $pkg"
    done < "$PACKAGES_LIST"
  } > "$tmp" 2>/dev/null || return 0
  chmod 0644 "$tmp" 2>/dev/null
  mv -f "$tmp" "$UID_PACKAGES_OUT" 2>/dev/null || return 0
  echo "$stamp" > "$UID_PACKAGES_OUT.stamp" 2>/dev/null
}

# root 侧写下「当前前台应用」（一行 `<epoch 秒> <包名>`）给 daemon 做最后一道兜底：
# 内核 uid 翻不出包名（分身/空间/多用户那类机器）时，daemon 就用它。
# 这件事比读文件贵（要跑一次 dumpsys），所以只每 FOREGROUND_EVERY 拍干一次。
# 采不到就保留上一份 —— daemon 那边带新鲜度阀，旧了它自己不用。
sync_foreground() {
  local pkg tmp now
  # 先试最便宜的一条：`cmd activity get-top-activity` 只回一行 `ACTIVITY pkg/cls`，
  # 比 `dumpsys window displays` 那份全量 dump 小两三个数量级。
  # 但它不是每个 ROM 都有（本机 Android 16 就回 Unknown command），所以只在第一拍探一次，
  # 探到了才走这条，探不到就跟以前一样直接 dumpsys —— 不能每拍白 fork 一次。
  if [ -z "${TOP_ACTIVITY_PROBED:-}" ]; then
    TOP_ACTIVITY_PROBED=1
    TOP_ACTIVITY_OK=0
    cmd activity get-top-activity 2>/dev/null | grep -q '^ACTIVITY ' && TOP_ACTIVITY_OK=1
  fi
  if [ "${TOP_ACTIVITY_OK:-0}" = 1 ]; then
    pkg=$(cmd activity get-top-activity 2>/dev/null \
      | sed -n 's/^ACTIVITY \([a-zA-Z0-9_][a-zA-Z0-9_.]*\)\/.*/\1/p' | head -n1)
  fi
  # 两条 dumpsys 路留着当退路：不同 ROM 用的字段不一样（实测 nubia 是 mCurrentFocus /
  # topResumedActivity，老的是 mResumedActivity）。取包名的 sed 是贪心的 —— 一行里可能有
  # Window{hash u0 pkg/cls} 这种，要的是最后一个 `pkg/` 前的包名。
  if [ -z "$pkg" ]; then
    pkg=$(dumpsys window displays 2>/dev/null | grep -m1 mCurrentFocus \
      | sed -n 's/.* \([a-zA-Z0-9_][a-zA-Z0-9_.]*\)\/[^ }]*.*/\1/p')
  fi
  if [ -z "$pkg" ]; then
    pkg=$(dumpsys activity activities 2>/dev/null \
      | grep -m1 -E "topResumedActivity|mResumedActivity" \
      | sed -n 's/.* \([a-zA-Z0-9_][a-zA-Z0-9_.]*\)\/[^ }]*.*/\1/p')
  fi
  [ -n "$pkg" ] || return 0
  now=$(date +%s 2>/dev/null) || return 0
  tmp=$FOREGROUND_OUT.tmp
  echo "$now $pkg" > "$tmp" 2>/dev/null || return 0
  chmod 0644 "$tmp" 2>/dev/null
  mv -f "$tmp" "$FOREGROUND_OUT" 2>/dev/null
}

restart_keystore() {
  local pid
  pid=$1
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    log "[injector-daemon] restart requested; stopping keystore2 pid=$pid"
    kill -TERM "$pid" 2>/dev/null
    sleep 2
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null
    fi
  fi
}

mkdir -p "$STATE_DIR"
LOG_ON=0
soter_attk_changed=0
sog_once=0
pending_restart=0
last_attempt_pid=
last_attempt_at=0
retry_cooldown=15
soter_start_attempted=0
# 宿主保活用的节流：宿主不在时最多每 30 秒拉起一次，别每拍都去 am start-service。
last_soter_start_at=0
# SOTER 的 HIDL 客户端（cryptoeng 这种）多久点一次注入。
last_soter_hidl_at=0
# 第一次看到「宿主在跑但没注上」的时刻（epoch 秒），注完把间隔写进日志。
soter_seen_at=
last_soter_pid=
last_soter_attempt_at=0

# 开机头 90 秒里紧凑轮询（3 秒一次）：keystore2 一出现就注上，别等 5 秒的节拍。
# 因为框架的 onDeviceUnlocked 只有你解锁那一刻一次、从不补发 —— 那一瞬间我们不在
# keystore2 里，这份解锁材料就永久丢了（影子 keystore 会一直 LOCKED 到下次解锁）。
EARLY_POLL_SECONDS=90
started_at=$(date +%s 2>/dev/null || echo 0)
# 主循环的拍数：前台那个活代价比读文件大，没必要每拍都干（见 sync_foreground）。
tick=0
# 前台应用每拍都采。拍子的节奏是：开机前 90 秒 3 秒一拍，之后 5 秒一拍（见 tick_sleep）。
# 所以实际是「开机阶段 3 秒、平时 5 秒」——这条兜底的意义就是「现在是谁在调」，
# 拖到 10 秒/60 秒切个 App 就对不上了。
#
# （试过改成「keymint 用到时现问」：行不通——keymint 跑在 keystore 域，
#   exec dumpsys 会被 SELinux 挡；`am monitor` 只报崩溃/ANR，不报前台切换。）
FOREGROUND_EVERY=1
tick_sleep() {
  ticks=$((ticks + 1))
  # --once：跑完一轮就退出（调试用）。
  # 放在这里而不是循环末尾，是因为 prepare_injector 失败那条 continue 也会调到这里。
  if [ "${MAX_TICKS:-0}" -gt 0 ] && [ "$ticks" -ge "$MAX_TICKS" ]; then
    release_lock
    exit 0
  fi
  now=$(date +%s 2>/dev/null)
  if [ -n "$now" ] && [ "$started_at" -gt 0 ] && [ $((now - started_at)) -lt $EARLY_POLL_SECONDS ]; then
    sleep 3
  else
    sleep 5
  fi
}

# --once：只跑一轮（给 Rust watchdog 用）；不带参数时是常驻轮询。
ticks=0
MAX_TICKS=0
case "${1:-}" in
  --once) MAX_TICKS=1 ;;
esac

# 单实例：同 daemon 那层 —— service.sh 的看门循环可能同时存在多份，每份 fork 一个
# 注入器；多份并存时每轮都会 pkill 掉对方正在用的 keystore2/注入进程。抢不到锁就退。
LOCK_DIR=$RUN_DIR/injector-daemon.lock
PID_FILE=$RUN_DIR/injector-daemon.pid

# 锁里记 `pid starttime`。以前靠 cmdline 里有没有 `sh <脚本>` 认人，但脚本现在可以
# 从标准输入读（启动器给的 memfd），/proc 里根本看不到脚本路径；启动时刻则不会变。
proc_start_time() {
  [ -r "/proc/$1/stat" ] || return 1
  sed 's/^.*) //' "/proc/$1/stat" 2>/dev/null | awk '{print $20}'
}

owner_stamp() { printf '%s %s\n' "$$" "$(proc_start_time $$)"; }

holder_is_us() {
  local p=$1 s=$2
  [ -n "$p" ] || return 1
  kill -0 "$p" 2>/dev/null || return 1
  if [ -z "$s" ] || [ "$s" = 0 ]; then
    return 0
  fi
  [ "$(proc_start_time "$p")" = "$s" ]
}

# 同 daemon 那层：抢锁有竞态，拿到之后要再核一次归属；退出只删自己的锁。
lock_owned() { [ "$(cat "$LOCK_DIR/pid" 2>/dev/null)" = "$(owner_stamp)" ]; }
release_lock() { lock_owned && rm -rf "$LOCK_DIR" 2>/dev/null; return 0; }

if [ "${OMMEGA_SKIP_LOCK:-0}" = 1 ]; then
  # 由外层持锁时（`OMMEGA_SKIP_LOCK=1`）这里只负责跑一轮，不抢锁（否则会以为自己
  # 是第二实例直接退出）。
  :
elif mkdir "$LOCK_DIR" 2>/dev/null; then
  :
else
  # 给对方一个写 pid 的窗口：刚 mkdir 成功的那一方可能还没写进来，读到空就立刻
  # 删锁重抢会造成两个实例同时跑（实测两个 injector 一起注入，各烧几十秒 CPU）。
  lock_i=0
  while [ "$lock_i" -lt 6 ]; do
    [ -s "$LOCK_DIR/pid" ] && break
    sleep 0.5
    lock_i=$((lock_i + 1))
  done
  set -- $(cat "$LOCK_DIR/pid" 2>/dev/null)
  if holder_is_us "${1:-}" "${2:-}"; then
    log "[injector-daemon] another instance (pid ${1:-}) is running; exiting"
    exit 0
  fi
  rm -rf "$LOCK_DIR" 2>/dev/null
  mkdir "$LOCK_DIR" 2>/dev/null || exit 0
fi
# 只有自己真的是持锁者才写 pid：--once 模式（watchdog 持锁）写了会把别人的锁偷走。
if [ "${OMMEGA_SKIP_LOCK:-0}" != 1 ]; then
  owner_stamp > "$LOCK_DIR/pid"
  sleep 1
  lock_owned || exit 0
  # 给 service.sh 的巡检看：pidfile 是 `pid starttime`，它不认名字只认启动时刻。
  owner_stamp > "$PID_FILE"
fi
# 宿主能不能自己干活，由 root 这边看一眼它的 APK 就能定：dex 里认得出我们伺候的那几家
# SOTER HAL 厂商前缀（qti / trustonic / xiaomi / microtrust）才是 real；其余一律当 stub ——
# 壳子连 soter HAL 字样都没有，而带 HAL 词汇但厂商前缀我们不认识的机器 soterta 顶不上，
# 真真 TA 的坏话会直达 App，只有让载荷把宿主给 App 的答复顶掉（见 hook/soter.rs 的
# take_app_answer）。结果写一份世界可读的小文件，宿主里的载荷读它 —— 宿主进程自己按
# /proc/self/maps 猜 APK 会猜错（那里有几十个 overlay 的 apk，自己的不在第一）。
# 杀软件 SOTER TA（我们自己的那个）。名字表里 soterta= 那条是它的伪装路径，
# 再配上「exe 指向 memfd」就不会误杀同名的真系统服务。
kill_software_ta() {
  local p kt_cmd
  for p in $(ls /proc | grep -E '^[0-9]+$'); do
    # 先按 exe 筛（只有我们自己的才在 memfd 里），再读 cmdline —— 不能对全系统的
    # 进程读 cmdline，碰到卡在 D 状态的目标会把调用方一起卡死。
    case "$(readlink "/proc/$p/exe" 2>/dev/null)" in
      /memfd:*) ;;
      *) continue ;;
    esac
    kt_cmd=$(timeout 2 cat "/proc/$p/cmdline" 2>/dev/null | tr '\0' ' ')
    case "$kt_cmd" in
      *--soterta-serve*) kill -9 "$p" 2>/dev/null ;;
    esac
  done
  return 0
}

# 反向保活：keymint 守护被系统清掉时拉它一把（守护也会反过来保活注入器）。
# 两个常驻进程互相看着，就不需要第三个看门狗进程了 —— 以前那个是 service.sh 里的
# 常驻 shell 循环，进程列表里一个带模块路径的 busybox。
ensure_keymint_daemon() {
  ekd_pid=$(awk 'NR==1{print $1}' "$RUN_DIR/keymint-daemon.pid" 2>/dev/null)
  ekd_stamp=$(awk 'NR==1{print $2}' "$RUN_DIR/keymint-daemon.pid" 2>/dev/null)
  if [ -n "$ekd_pid" ] && kill -0 "$ekd_pid" 2>/dev/null; then
    if [ -z "$ekd_stamp" ] || [ "$ekd_stamp" = 0 ] || [ "$(proc_start_time "$ekd_pid")" = "$ekd_stamp" ]; then
      return 0
    fi
  fi
  # pidfile 可能被清理脚本删了：再按名字表里的 comm 找一遍（exe 必须是 memfd，
  # 否则可能是同名的真系统进程）。不然每 5 秒重拉一个守护，每个都要把 8MB
  # 二进制读进 memfd，白白烧 CPU。
  ekd_name=$(sed -n 's/^daemon=//p' /data/misc/ommega/conf/stealth.names 2>/dev/null | head -n 1)
  if [ -n "$ekd_name" ]; then
    ekd_comm=$(echo "$ekd_name" | sed 's|.*/||' | cut -c1-15)
    for ekd_d in /proc/[0-9]*; do
      case "$(readlink "$ekd_d/exe" 2>/dev/null)" in
        /memfd:*) ;;
        *) continue ;;
      esac
      [ "$(cat "$ekd_d/comm" 2>/dev/null)" = "$ekd_comm" ] && return 0
    done
  fi
  ekd_abi=$(device_abi)
  ekd_km=$MODDIR/libs/$ekd_abi/keymint
  [ -x "$ekd_km" ] || return 0
  log "[injector-daemon] keymint daemon looks dead; restarting it"
  "$ekd_km" --daemon >/dev/null 2>&1 &
  return 0
}

sync_soter_host_state() {
  local pkg path want prev
  pkg=com.tencent.soter.soterserver
  path=$(pm path "$pkg" 2>/dev/null | head -n 1 | sed 's/^package://')
  [ -n "$path" ] || return 0
  [ -r "$path" ] || return 0
  # 逐个厂商前缀对一遍（不用 -E/-o：不同 ROM 的 toybox/busybox grep 支持面不一样，
  # -o -E 在这台 NX721J 上能用、在别的机器上未必）。认得出我们伺候的那几家才是 real，
  # 其余（壳、以及带 soter HAL 词汇但厂商前缀我们不认识的机器）一律 stub，让载荷把
  # 宿主给 App 的答复顶掉。
  want=stub
  for vendor in qti trustonic xiaomi microtrust; do
    if grep -a -q "vendor.$vendor.hardware.soter" "$path" 2>/dev/null; then
      want=real
      break
    fi
  done
  prev=$(cat "$SOTER_HOST_STATE_OUT" 2>/dev/null | tr -d ' \r\n')
  [ "$prev" = "$want" ] && return 0
  printf '%s\n' "$want" > "$SOTER_HOST_STATE_OUT" 2>/dev/null || return 0
  chmod 0644 "$SOTER_HOST_STATE_OUT" 2>/dev/null
  log "[injector-daemon] soter host apk $path -> $want"
}

trap 'release_lock' EXIT INT TERM HUP

sync_soter_host_state
while true; do
  # Config and target list live in the single data location
  # (/data/misc/ommega/); the webroot UI writes them through the
  # ommegadata symlink, so no copy/sync is needed here.

  # 先确保 keymint 守护在（它挂了的话，下面所有注入都白做）。
  ensure_keymint_daemon

  LOG_ON=0
  debug_logging_enabled && LOG_ON=1
  sync_log_flag
  sync_uid_packages
  if [ $((tick % FOREGROUND_EVERY)) -eq 0 ]; then
    sync_foreground
  fi
  tick=$((tick + 1))
  # 开机早期 `pm` 还没就绪（那时 `pm path` 拿不到路径，判定会直接放过），所以不能只在
  # 启动时判一次：文件没写出来就接着重试，写出来之后每 60 个 tick 再校对一遍（宿主
  # 换版本时也能跟上）。
  if [ ! -s "$SOTER_HOST_STATE_OUT" ] || [ $((tick % 60)) -eq 0 ]; then
    sync_soter_host_state
  fi
  sync_soter_attk
  sync_soter_cpu_id
  if [ "$soter_attk_changed" = "1" ]; then
    # ATTK 换了：旧的 ASK / AuthKey / counter 全部作废。它们要么是用旧 ATTK 签的，
    # 要么只对旧身份有意义；留着会让 App 拿旧状态去上报，腾讯一验就失败，
    # 然后自删自建死循环。清掉之后每个 App 下次请求现造 ASK，counter 从 1 开始。
    # 换了 ATTK = 新身份：ASK/AuthKey 作废，counter 也从 1 重新开始。
    # 关键是要**连 App 自己那份开通状态一起清**（见下面几行）——只清 counter
    # 不清 App，它会记着旧号、看到 1 就当回退，得连按好几次才追上来。
    rm -f /data/misc/ommega/soter_asks.json /data/misc/ommega/soter_counter 2>/dev/null
    log "[injector-daemon] ATTK changed; cleared ASK/authkey/counter"
    # App 自己那份「已开通」也得作废：微信这类把 WechatASK=1 记在
    # shared_prefs/soter_status.xml 里，不清它就不会重走开通，继续拿旧链签名 ——
    # 本地验得过、腾讯不认，就是「换了 ATTK 也没反应」那种卡住。
    _cleared=0
    for _f in /data/user/*/*/shared_prefs/soter_status.xml*; do
      [ -f "$_f" ] || continue
      if rm -f "$_f" 2>/dev/null; then _cleared=$((_cleared + 1)); fi
    done
    log "[injector-daemon] ATTK changed; cleared soter_status of $_cleared app(s)"
    # 软件 TA 是独立进程，内存里那份 ASK 也得跟着没（它自己不会去读文件）。
    # 它现在跑在 memfd 里、名字是伪装的系统服务，pidof 认不出来 —— 按名字表 + memfd 找。
    kill_software_ta
    # ASK/ATTK 换了：keystore2 里那份 payload 的 state（ATTK 与已加载的 ASK）是启动时
    # 一次性加载的，只踢 SOTER 宿主不会重读，必须让 keystore2 重新注入一次。
    : > "$RESTART_FILE"
    run_soter_selftest
  fi

  if [ "$sog_once" = "0" ]; then
    run_soter_selftest
  fi

  if ! prepare_injector; then
    tick_sleep
    continue
  fi

  # SOTER 的 HIDL 客户端（一加的 cryptoeng 这类产线/工程模式工具）得单独注一次：
  # 它们调的是 `vendor.qti.hardware.soter@1.0::ISoter`，跟宿主那条 AIDL 路不是一套，
  # 不注进去，工程模式那页的 SOTER 项就一直吃原厂 TA 的 -20。injector 自己是幂等的
  # （已经注过的目标会直接跳过），所以每 60 秒点一次就够，不用在这里做发现。
  # 宿主「收得到 App 调用、却一笔都不往 HAL 发」时没人救：payload 判定完写这个标记，
  # 这里读到就换实例——只有换实例能把它拽回来。读完即删，免得每拍都踢。
  if [ -f "$SOTER_STUCK_FILE" ]; then
    rm -f "$SOTER_STUCK_FILE" 2>/dev/null
    log "[injector-daemon] soter host reported stuck; restarting it"
    restart_soter_host "it stopped forwarding to the HAL"
  fi

  # 宿主是 bind-only：没人喊就没人起。开了接管但宿主还没起来的，替客户端先喊一声；
  # 只试一次，不成就靠下一拍的巡检报出来，不在这里循环重试。
  if soter_inject_enabled && [ "$soter_start_attempted" = "0" ] && [ -z "$(soter_pid)" ]; then
    soter_start_attempted=1
    start_soter_service
  fi

  if soter_inject_enabled; then
    now_hidl=$(date +%s 2>/dev/null || echo 0)
    if [ "$now_hidl" -gt 0 ] && [ $((now_hidl - last_soter_hidl_at)) -ge 60 ]; then
      last_soter_hidl_at=$now_hidl
      OMMEGA_INJECT_TARGETS=soter-hidl "$TARGET_INJECTOR" >/dev/null 2>&1
    fi
  fi

  if consume_restart_request; then
    pending_restart=1
    restart_keystore "$(get_keystore_pid)"
    if ! prepare_injector; then
      tick_sleep
      continue
    fi
  fi


  # SOTER 宿主只要接管开着就总是注一份。
  # HIDL 平台（MEIZU 20 Pro / 骁龙 8 Gen2）客户端走 hwservicemanager，那个名字我们顶不了，
  # 只能注进宿主，在它进程里把发往 HAL 的那笔截下来自己答（hook/soter.rs）。
  # AIDL 平台大多数时候用不上，但有的 ROM 把宿主整个换成只会回 -200 的壳（Oppo/ColorOS 实测：
  # SoterService.apk 17 KB，压根不发 HAL 请求），那种机器只能靠宿主里的载荷把 App 那笔答复
  # 顶掉（`hook/soter.rs` 的 `take_app_answer`）。壳与否由载荷自己判（壳的 APK 里没有 HAL
  # 服务名），真宿主上不会动它。
  if soter_inject_enabled && soter_host_needs_payload; then
    inject_targets=keystore2,soter
  else
    inject_targets=keystore2
  fi

  pid=$(get_keystore_pid)
  keystore_pending=0
  if [ -z "$pid" ]; then
    last_attempt_pid=
  elif ! is_injected "$pid"; then
    keystore_pending=1
  fi

  spid=$(soter_pid)
  soter_pending=0
  if [ "$inject_targets" != "keystore2" ] && [ -n "$spid" ] && ! is_injected "$spid"; then
    soter_pending=1
    # 第一眼看到“在跑但没注上”的时刻：注完算间隔用。
    [ -n "$soter_seen_at" ] || soter_seen_at=$(date +%s 2>/dev/null)
  else
    soter_seen_at=
  fi

  if [ "$keystore_pending" -eq 0 ] && [ "$soter_pending" -eq 0 ]; then
    pending_restart=0
    last_attempt_pid=
    last_soter_pid=
    tick_sleep
    continue
  fi

  # 同一个目标连着注失败就缓一下，别每 5 秒拿 ptrace 去戳一次。
  now=$(date +%s 2>/dev/null)
  if [ -n "$now" ] && [ "$pending_restart" -eq 0 ]; then
    if [ "$keystore_pending" -eq 1 ] && [ "$last_attempt_pid" = "$pid" ] \
      && [ "$now" -lt $((last_attempt_at + retry_cooldown)) ]; then
      tick_sleep
      continue
    fi
    # 宿主换了 pid（刚重启）就不吃冷却：那个空窗就压在这里 —— 立刻注，不等 retry_cooldown。
    if [ "$soter_pending" -eq 1 ] && [ "$last_soter_pid" = "$spid" ] \
      && [ "$now" -lt $((last_soter_attempt_at + retry_cooldown)) ]; then
      tick_sleep
      continue
    fi
  fi

  # 清掉一个残留的注入器实例再注，免得上一次的注入器和新的并存。
  # **只杀「光秃秃就是那个路径」的那条**：同一个二进制既是注入器、又是软件 SOTER TA
  # （`--soterta-serve`）。以前用 `pkill -9 -f "$TARGET_INJECTOR"` 是按子串匹配，会把
  # TA 一起杀掉 —— 只注 keystore2 时看不出来（那条路早就注完了，走不到这里），一旦开始
  # 注宿主就成了死循环：杀 TA → soterta.sh 拉起 → 踢宿主 → 守护进程再注入 → 再杀 TA。
  for stale in $(ps -A -o PID,ARGS 2>/dev/null | awk -v t="$TARGET_INJECTOR" 'NF == 2 && $2 == t {print $1}'); do
    kill -9 "$stale" 2>/dev/null
  done
  sleep 1
  if [ "$keystore_pending" -eq 1 ]; then
    log "[injector-daemon] injecting into keystore2 pid=$pid via $TARGET_INJECTOR"
  else
    gap=""
    if [ -n "$soter_seen_at" ]; then
      gap=" gap=$(( $(date +%s 2>/dev/null || echo 0) - soter_seen_at ))s"
    fi
    log "[injector-daemon] injecting into $SOTER_PKG pid=$spid via $TARGET_INJECTOR$gap"
  fi
  OMMEGA_INJECT_TARGETS="$inject_targets" "$TARGET_INJECTOR"
  rc=$?
  last_attempt_pid=$pid
  last_attempt_at=$(date +%s 2>/dev/null)
  last_soter_pid=$spid
  last_soter_attempt_at=$last_attempt_at
  pending_restart=0
  log "[injector-daemon] injector exited with code $rc"
  sleep 3
done
